# Secrets - never commit
/config/master.key
/config/*.key
.env*
!.env.example

# Dependencies
/node_modules
/vendor/bundle

# Logs, temp, uploads
/log/*
!/log/.keep
/tmp/*
!/tmp/.keep
/storage/*
!/storage/.keep

# Build output
/public/assets
/app/assets/builds/*
!/app/assets/builds/.keep

# OS / editor
.DS_Store
*.swp
.idea
.vscode
